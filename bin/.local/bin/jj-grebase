#!/usr/bin/env python3

import sys
import os
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from jj_utils import run, get_single_bookmark_at_parent, detect_main_branch


def main():
    # Step 1: Get the single bookmark from the parent commit
    bookmark = get_single_bookmark_at_parent(action="rebase")

    # Step 2: Find main/master
    main_branch = detect_main_branch()

    # Step 3: Rebase
    print(f"Rebasing bookmark '{bookmark}' onto '{main_branch}'...")
    run(f"jj rebase -b {bookmark} -d {main_branch}")


if __name__ == "__main__":
    main()
