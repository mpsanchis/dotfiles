#!/usr/bin/env python3

import sys
import os
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from jj_utils import run, assert_jj_repo, get_single_bookmark_at_parent


def main():
    # Pre-check: is jj in this repo?
    assert_jj_repo()

    # Step 1: Get the single bookmark from the parent commit
    bookmark = get_single_bookmark_at_parent(action="push")

    # Step 2: Push it
    print(f"Pushing bookmark: {bookmark}")
    run(f"jj git push -b {bookmark}")


if __name__ == "__main__":
    main()
